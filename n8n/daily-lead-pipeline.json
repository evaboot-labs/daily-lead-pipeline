      "id": "231b15dd-0df5-435a-ab4d-85adad8acec8",
      "name": "Latest exports",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Evaboot MCP (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// The newest export whose name starts with the recurring export name: today's run.\nconst s = $('Your settings').first().json;\nconst list = $json.structuredContent?.result || [];\nconst run = list.find(e => String(e.search_name || '').startsWith(s.recurring_export_name));\nif (!run) throw new Error(`No export named \"${s.recurring_export_name}\" yet.`);\nif (run.status !== 'EXECUTED') throw new Error(`The newest run is ${run.status}, not finished yet.`);\nconst ageH = (Date.now() - new Date(run.search_date_created.replace(' ', 'T'))) / 36e5;\nif (ageH > 24) return [];  // no new run today: stop quietly\nreturn [{ json: { extraction_id: run.search_id, name: run.search_name } }];\n"
      },
      "id": "24c59d4d-9051-48f9-9ebf-e8cdaafcf3c2",
      "name": "Today's run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "endpointUrl": "https://mcp.evaboot.com/mcp",
        "authentication": "bearerAuth",
        "tool": {
          "__rl": true,
          "mode": "list",
          "value": "get_export",
          "cachedResultName": "get_export"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ extraction_id: $json.extraction_id }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "6ccdaf5a-f869-4812-86d4-a28511e86131",
      "name": "Get the leads",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Evaboot MCP (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// Leads that match your filters with a safe email, with the facts Claude may use.\nconst num = v => { const n = parseFloat(String(v ?? '').replace(/,/g, '')); return isNaN(n) ? null : n; };\nconst words = s => String(s || '').split(/\\s+/).join(' ').trim();\nconst all = $json.structuredContent?.result?.prospects || [];\nconst kept = all.filter(p => p['Matches Filters'] === 'YES' && p['Email Status'] === 'safe');\nif (!kept.length) return [];\nreturn kept.map(p => ({ json: {\n  id: p['Email'], email: p['Email'], first_name: p['First Name'] || '', last_name: p['Last Name'] || '',\n  title: String(p['Current Job'] || '').trim(), company: p['Company Name'] || '', company_domain: p['Company Domain'] || '',\n  linkedin_url: p['Linkedin URL Public'] || '',\n  time_in_role: [[num(p['Years in Position']), 'year'], [num(p['Months in Position']), 'month']]\n    .filter(([n]) => n).map(([n, u]) => `${n} ${u}${n > 1 ? 's' : ''}`).join(' ') || 'under a month',\n  new_position: String(p['Has New Position']).toLowerCase() === 'yes',\n  headline: words(p['Profile Headline']), summary: words(p['Profile Summary']).slice(0, 600),\n  job_description: words(p['Job Description']).slice(0, 400),\n  company_description: words(p['Company Description']).slice(0, 400),\n  company_headcount: num(p['Company Employee Exact Count']),\n  company_growth_6m_pct: num(p['Company Employee Growth 6 Months (%)']),\n  company_growth_1y_pct: num(p['Company Employee Growth 1 Year (%)']),\n  company_growth_2y_pct: num(p['Company Employee Growth 2 Years (%)']),\n  revenue_musd: [p['Company Revenue Min (Millions USD)'], p['Company Revenue Max (Millions USD)']].filter(Boolean).join(' to ') || null,\n  sales_team: num(p['Sales Team Size']),\n} }));\n"
      },
      "id": "72658a73-8e01-481b-b374-17df101fe1db",
      "name": "Leads to email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
