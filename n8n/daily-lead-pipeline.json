    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.leads) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You write the first cold email to each lead in the JSON you are given, following the brief below. Use only the facts in the JSON and the brief: never invent a customer, a number or a result.\nFor each lead return {id, subject, body}, or {id, skip: true, reason} when nothing in the data fits the brief. Separate paragraphs with a blank line.\n\nBrief:\n{{ $('Your settings').first().json.brief }}",
          "maxIterations": 3
        }
      },
      "id": "bf6bb9cf-e338-4c8e-8fdf-5721bdeaa0ae",
      "name": "Write the emails",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1540,
        120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
